# Override default environment variables
# Copy file to '.env'to edit the environment variables.

# =========================
# Docker Compose Variables
# =========================

COMPOSE_PROJECT_NAME='docker-multidb'

# =========================
# Scripts Variables
# 
# SCRIPTS_UTILITY_D: Utility scripts directory
# SCRIPTS_INITDB_D: Initialization scripts directory
# SCRIPTS_HEALTHCHECK_D: Healthcheck scripts directory
# SCRIPTS_HEALTHCHECK_PATH: Healthcheck script entrypoint
# =========================

SCRIPTS_UTILITY_D=
SCRIPTS_INITDB_D=
SCRIPTS_HEALTHCHECK_D=
SCRIPTS_HEALTHCHECK_PATH=

# =========================
# PostgreSQL Variables
# 
# POSTGRES_MULTIPLE_DB: Comma-separated list of extra databases to build
# Example:
#   POSTGRES_MULTIPLE_DB=db1,db2,...
#   POSTGRES_MULTIPLE_DB="db-1, db-2, ..."
#   POSTGRES_MULTIPLE_DB="db1_name/db1_user:db1_password, db2_name/db2_user:db2_password, ..."
# =========================

POSTGRES_PASSWORD=
POSTGRES_USER=
POSTGRES_DB=
POSTGRES_MULTIPLE_DB=
